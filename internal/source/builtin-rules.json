    { "domain": "github.com", "kind": "Dynamic" },
    { "domain": "*.github.com", "kind": "Dynamic" },
    { "domain": "*.githubusercontent.com", "kind": "Dynamic" },
    { "domain": "github.io", "kind": "Dynamic" },
    { "domain": "*.github.io", "kind": "Dynamic" },
    { "domain": "githubassets.com", "kind": "Dynamic" },
    { "domain": "*.githubassets.com", "kind": "Dynamic" },
    { "domain": "githubapp.com", "kind": "Dynamic" },
    { "domain": "github.dev", "kind": "Dynamic" },
    { "domain": "githubstatus.com", "kind": "Dynamic" },
    { "domain": "hub.docker.com", "kind": "Dynamic" },
    { "domain": "registry-1.docker.io", "kind": "Dynamic" },
    { "domain": "auth.docker.io", "kind": "Dynamic" },
    { "domain": "index.docker.io", "kind": "Dynamic" },
    { "domain": "production.cloudflare.docker.com", "kind": "Dynamic" },
    { "domain": "*.docker.io", "kind": "Dynamic" },
    { "domain": "huggingface.co", "kind": "Dynamic" },
    { "domain": "cdn-lfs.huggingface.co", "kind": "Dynamic" },
    { "domain": "cdn-lfs-us-1.huggingface.co", "kind": "Dynamic" },
    { "domain": "cas-bridge.xethub.hf.co", "kind": "Dynamic" },
    { "domain": "*.hf.co", "kind": "Dynamic" }
  ]
